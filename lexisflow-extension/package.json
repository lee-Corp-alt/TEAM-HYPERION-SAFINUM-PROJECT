{
  "name": "lexisflow-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vitest run && vite build --mode content && vite build --mode background && vite build --mode popup",
    "test": "vitest run",
    "worksheet": "node scripts/worksheet.ts",
    "review:export": "node scripts/review-sheet.ts export",
    "review:import": "node scripts/review-sheet.ts import",
    "review:priority": "node scripts/priority-sheet.ts",
    "postbuild": "node scripts/licenses.mjs",
    "ui:export": "node scripts/ui-review.mjs export",
    "ui:import": "node scripts/ui-review.mjs import"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
